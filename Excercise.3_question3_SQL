--Step 1: Create a Catalog 
CREATE CATALOG IF NOT EXISTS employees;
--Step 2: Create Schema
CREATE SCHEMA IF NOT EXISTS employees.default;
--Step 3: Create Table
CREATE TABLE IF NOT EXISTS employees.default.salary
(employee_id INT,
empployee_name STRING,
department STRING,
salary INT
);
