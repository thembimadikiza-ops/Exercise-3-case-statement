 --Question 3: Combine the department and salary columns to label each employee with a seniority tier.
SELECT
empployee_name,
department,
salary,
CASE
WHEN department = 'IT' AND salary > 80000 THEN 'senior'
WHEN department = 'HR' AND salary > 55000 THEN 'Experienced HR'
ELSE 'Staff'
END AS position_level
FROM employees.default.salary
