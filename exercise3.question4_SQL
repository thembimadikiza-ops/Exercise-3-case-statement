--question 4:A list of student scores. Convert numeric scores into letter grades
SELECT
student_name,
score,
CASE
WHEN score >= 90 THEN 'A'
WHEN score between 80 AND 89 THEN 'B'
WHEN score between 70 AND 79 THEN 'C'
WHEN score between 60 AND 69 THEN 'D'
WHEN score <60 THEN 'F'
END AS grade
FROM students.default.employees;
