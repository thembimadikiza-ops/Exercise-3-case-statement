--Step 1: Create Catalog
CREATE CATALOG IF NOT EXISTS students;
--step 2: Create schema
CREATE SCHEMA IF NOT EXISTS students.default;
--step 3: Create the table 
CREATE TABLE IF NOT EXISTS students.default.employees (student_id INT, student_name STRING, score INT
);
